# ==============================================================================
# Git attributes — SideXP Unity package
#
# Base: gitattributes/gitattributes Unity template (MIT):
#   https://github.com/gitattributes/gitattributes/blob/master/Unity.gitattributes
# Adapted for a distributable UPM package:
#   - No Git LFS. Packages install via UPM (git URL / registry), where LFS objects
#     are NOT fetched, so the [attr]lfs macro is redefined to plain "binary".
#   - Adds a "* text=auto eol=lf" catch-all and CRLF for .bat/.cmd scripts.
#   - Keeps the export-ignore block so the Release workflow's archive stays clean.
#
# After changing this file, renormalize text endings once:
#     git add --renormalize .
#     git commit -m "chore: normalize line endings"
# ==============================================================================

# Define macros (only works in top-level gitattributes files)
# NOTE: LFS intentionally DISABLED for distributable packages — "lfs" == binary.
[attr]lfs               binary
[attr]unity-json        eol=lf linguist-language=json
[attr]unity-yaml        merge=unityyamlmerge eol=lf linguist-language=yaml

# Default: treat as text and normalize to LF in the repo and working tree on every
# OS. Overrides each developer's local core.autocrlf. Specific rules below win.
* text=auto eol=lf

# Unity source files
*.cginc                 text
*.compute               text linguist-language=hlsl
*.cs                    text diff=csharp
*.hlsl                  text linguist-language=hlsl
*.raytrace              text linguist-language=hlsl
*.shader                text

# Unity JSON files
*.asmdef                unity-json
*.asmref                unity-json
*.index                 unity-json
*.inputactions          unity-json
*.shadergraph           unity-json
*.shadersubgraph        unity-json

# Unity UI Toolkit files
*.tss                   text diff=css linguist-language=css
*.uss                   text diff=css linguist-language=css
*.uxml                  text linguist-language=xml linguist-detectable

# Unity YAML files
*.anim                  unity-yaml
*.asset                 unity-yaml
*.brush                 unity-yaml
*.controller            unity-yaml
*.flare                 unity-yaml
*.fontsettings          unity-yaml
*.giparams              unity-yaml
*.guiskin               unity-yaml
*.lighting              unity-yaml
*.mask                  unity-yaml
*.mat                   unity-yaml
*.meta                  unity-yaml
*.mixer                 unity-yaml
*.overrideController    unity-yaml
*.playable              unity-yaml
*.prefab                unity-yaml
*.preset                unity-yaml
*.renderTexture         unity-yaml
*.scenetemplate         unity-yaml
*.shadervariants        unity-yaml
*.signal                unity-yaml
*.spriteatlas           unity-yaml
*.spriteatlasv2         unity-yaml
*.terrainlayer          unity-yaml
*.unity                 unity-yaml

# "physic" for 3D but "physics" for 2D
*.physicMaterial        unity-yaml
*.physicsMaterial2D     unity-yaml

# ------------------------------------------------------------------------------
# Binary asset types. The "lfs" macro above maps to "binary", so these are stored
# directly in Git (no LFS). Kept as "lfs" to stay diff-able against the upstream
# Unity template; flip the [attr]lfs macro to re-enable LFS if a package needs it.
# ------------------------------------------------------------------------------

# Unity binaries
*.cubemap               lfs
*.unitypackage          lfs

# 3D models
