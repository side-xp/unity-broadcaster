# Executable/Installer
*.apk                   lfs
*.exe                   lfs

# Documents
*.pdf                   lfs

# ETC
*.a                     lfs
*.reason                lfs
*.rns                   lfs

# Spine export file for Unity
*.skel.bytes            lfs

# CI shell scripts must use LF endings to run on Linux runners
*.sh                    text eol=lf

# Windows batch scripts must keep CRLF (labels/goto can misbehave with LF)
*.bat                   text eol=crlf
*.cmd                   text eol=crlf

# ------------------------------------------------------------------------------
# Files excluded from `git archive` output (used by the Release workflow to build
# the package archives).
# ------------------------------------------------------------------------------
/.github       export-ignore
/.vscode       export-ignore
/.editorconfig export-ignore
/.vsconfig     export-ignore
.gitignore     export-ignore
.gitattributes export-ignore
